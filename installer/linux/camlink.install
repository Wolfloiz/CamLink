# Mensagens e ganchos pós-instalação do pacote Arch (T066).
# Faz o que o install.sh faria: recarrega o udev, carrega o módulo e avisa
# sobre o grupo `video` (o pacote não pode adivinhar qual usuário é o dono
# da sessão).

_post() {
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --subsystem-match=video4linux 2>/dev/null || true
  modprobe v4l2loopback 2>/dev/null || true
  cat <<'MSG'

CamLink instalado. Falta um passo manual, uma única vez:

    sudo usermod -aG video $USER      # e faça logout/login

Sem isso o app não consegue criar a câmera virtual (/dev/v4l2loopback é do
grupo video). Confira o estado com:

    /usr/share/camlink/install.sh --check

MSG
}

post_install() { _post; }
post_upgrade() { _post; }

post_remove() {
  udevadm control --reload-rules 2>/dev/null || true
}
